---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {
  wa, cop, cursos, examenes, licencias, seguridadSocial, terapias, exequial, otrosServicios, pagos,
} from '../data/site';

const minimo = (xs: number[]) => cop(Math.min(...xs));
---

<Base title="Precios 2026 | Línea Vital" description="Precios 2026 de cursos de alturas, exámenes médicos, licencias, seguridad social y más.">
  <section class="navy">
    <div class="wrap stack" style="padding-block: 56px 48px; gap: 14px;">
      <span class="tag">Precios 2026</span>
      <h1 class="h1 sm">Precios claros, <span class="g">por persona</span></h1>
      <p class="lead">Escríbenos con lo que necesitas y te confirmamos fecha y requisitos.</p>
    </div>
  </section>

  <section class="sec alt" style="padding-top: 40px;">
    <div class="wrap">
      <details class="pdet" open>
        <summary>Cursos y exámenes <span class="from">desde {minimo(examenes.map((e) => e.precio))}</span><Icon name="plus" size={18} /></summary>
        <div class="body">
          {cursos.map((c) => (
            <div class="row">
              <div><div class="name">{c.lista}</div><div class="small">{c.horas} horas</div></div>
              {c.precio ? <div class="price">{cop(c.precio)}</div> : <div class="avail">Según disponibilidad</div>}
            </div>
          ))}
          {examenes.map((e) => (
            <div class="row">
              <div><div class="name">{e.nombre}</div>{e.detalle && <div class="small">{e.detalle}</div>}</div>
              <div class="price">{cop(e.precio)}</div>
            </div>
          ))}
          <p class="note">Para el curso: documento de identidad, examen médico vigente, afiliación a seguridad social y RUT empresarial.</p>
        </div>
      </details>

      <details class="pdet">
        <summary>Licencias de conducción <span class="from">desde {minimo(licencias.map((l) => l.precio))}</span><Icon name="plus" size={18} /></summary>
        <div class="body">
          {licencias.map((l) => (
            <div class="row">
              <div><div class="name">{l.nombre}</div><div class="small">{l.detalle}</div></div>
              <div class="price">{cop(l.precio)}</div>
            </div>
          ))}
        </div>
      </details>

      <details class="pdet">
        <summary>Seguridad social <span class="from">desde {minimo(seguridadSocial.map((s) => s.eps))}</span><Icon name="plus" size={18} /></summary>
        <div class="body scroll">
          <table class="ss">
            <thead>
              <tr><th scope="col">Riesgo ARL</th><th scope="col">EPS</th><th scope="col">EPS + AFP</th><th scope="col">EPS + AFP + CCF</th></tr>
            </thead>
            <tbody>
              {seguridadSocial.map((s) => (
                <tr>
                  <th scope="row">{s.nivel}</th>
                  <td>{cop(s.eps)}</td>
                  <td>{cop(s.epsAfp)}</td>
                  <td>{s.epsAfpCcf ? cop(s.epsAfpCcf) : <span class="none" aria-label="No disponible">—</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="note">EPS salud · ARL riesgos laborales · AFP pensión · CCF caja de compensación. Paga los primeros 10 días de cada mes para no tener inconvenientes con servicios médicos e incapacidades.</p>
        </div>
      </details>

      <details class="pdet">
        <summary>Plan exequial <span class="from">{cop(exequial)}</span><Icon name="plus" size={18} /></summary>
        <div class="body">
          <div class="row">
            <div><div class="name">Exequias nacionales, hasta 7 familiares</div><div class="small">Velación en sede o casa, cofre, arreglo floral, transporte para la familia y trámites legales</div></div>
            <div class="price">{cop(exequial)}</div>
          </div>
          <div class="row">
            <div><div class="name">Repatriación internacional</div><div class="small">Desde cualquier país a su país de origen</div></div>
            <div class="avail">Se cotiza</div>
          </div>
        </div>
      </details>

      <details class="pdet">
        <summary>Terapias holísticas <span class="from">desde {minimo(terapias.map((t) => t.precio))}</span><Icon name="plus" size={18} /></summary>
        <div class="body">
          {terapias.map((t) => <div class="row"><div class="name">{t.nombre}</div><div class="price">{cop(t.precio)}</div></div>)}
        </div>
      </details>

      <details class="pdet">
        <summary>Otros servicios <span class="from">se cotizan</span><Icon name="plus" size={18} /></summary>
        <div class="body">
          <ul class="chips">{otrosServicios.map((s) => <li class="chip">{s}</li>)}</ul>
        </div>
      </details>

      <div style="margin-top: 40px;">
        <h2 class="h2" style="font-size: 22px;">Medios de pago</h2>
        <ul class="chips" style="margin-top: 14px;">{pagos.map((p) => <li class="chip">{p}</li>)}</ul>
        <p class="note">Los datos de pago te los enviamos por WhatsApp. Si pagas por transferencia, envíanos el comprobante con nombre y cédula.</p>
        <a class="cta" href={wa('Hola, vi los precios en la página y quiero información.')} target="_blank" rel="noopener" style="margin-top: 16px;">
          <Icon name="wa" size={18} /> Pedir por WhatsApp
        </a>
      </div>
    </div>
  </section>
</Base>
