---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Hero from '../components/Hero.astro';
import CtaBand from '../components/CtaBand.astro';
import { conceptos, RED_NACIONAL } from '../data/site';

// VALORES_2026.pdf, pág. 3 (Soluciones integrales).
const soluciones = [
  'Exámenes médicos ocupacionales',
  'Capacitación y certificación del talento humano',
  'Seguridad y prevención de riesgos',
  'Gestión de seguridad social y bienestar integral',
  'Asesoría e implementación del SG-SST',
];

// ENGAGED BPO CALI.pdf, pág. 5 (Alianza empresarial).
const alianza = [
  'Salud ocupacional',
  'Seguridad y prevención de riesgos',
  'Bienestar integral y desarrollo humano',
  'Optimización de costos empresariales',
  'Impacto positivo en productividad y calidad de vida de los trabajadores',
  'Reducción del ausentismo laboral',
  'Aumento de la satisfacción y bienestar de los equipos de trabajo',
];
---

<Base
  title="Nosotros | Línea+Vital"
  description="Aliado estratégico de las empresas colombianas en salud ocupacional, seguridad industrial y bienestar laboral."
>
  <Hero
    title="Un aliado estratégico"
    hl="para su empresa"
    tag="Nosotros"
    tagIcon="heart"
    sub="Nos convertimos en un aliado estratégico de las empresas colombianas, conectando salud, seguridad y bienestar con soluciones integrales."
    text="En Línea+Vital protegemos lo que realmente impulsa a las empresas: su gente. Somos especialistas en salud ocupacional, seguridad industrial y bienestar laboral."
  >
    <p class="ally"><Icon name="shield" size={18} /> Alianza estratégica con <b>Salud Total EPS</b></p>
  </Hero>

  <section class="sec">
    <div class="wrap grid2">
      <div class="panel">
        <span class="kicker"><Icon name="heart" size={16} /> Propósito</span>
        <p class="lead">Cuidar lo más valioso: la vida y el talento humano.</p>
      </div>
      <div class="panel">
        <span class="kicker"><Icon name="trend" size={16} /> Visión</span>
        <p class="lead">Ser el aliado estratégico de empresas colombianas en el cuidado integral de sus colaboradores, promoviendo ambientes de trabajo seguros, saludables y productivos.</p>
      </div>
    </div>
  </section>

  <section class="sec alt">
    <div class="wrap">
      <div class="head">
        <h2 class="h2">Lo que conectamos</h2>
      </div>
      <div class="grid3">
        {conceptos.map((c) => <div class="tile"><Icon name={c.icon} size={22} />{c.t}</div>)}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap two">
      <div>
        <h2 class="h2">Soluciones integrales</h2>
        <p class="sub">{RED_NACIONAL}</p>
        <ul class="checks">
          {soluciones.map((s) => <li><i><Icon name="check" size={14} /></i>{s}</li>)}
        </ul>
      </div>
      <div class="panel" style="background: var(--alt); border-color: transparent;">
        <span class="kicker"><Icon name="users" size={16} /> Alianza empresarial</span>
        <h3 class="h3">Una red sólida de servicios que integra</h3>
        <ul class="checks">
          {alianza.map((a) => <li><i><Icon name="check" size={14} /></i>{a}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <CtaBand title="Hablemos de su empresa" text="Cuéntanos qué necesitas y te orientaremos sobre el proceso." />
</Base>
