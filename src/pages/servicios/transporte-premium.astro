---
// Fuente única: brochure, pág. 8 (Luxury Auto Service). El brief no trae textos para esta página.
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Hero from '../../components/Hero.astro';
import CtaBand from '../../components/CtaBand.astro';

const msg = 'Hola, quiero información sobre el servicio de transporte premium.';

const servicios = [
  { icon: 'users', t: 'Servicio de conductor elegido' },
  { icon: 'globe', t: 'Expresos o viajes nacionales' },
  { icon: 'pin', t: 'Recogida puerta a puerta' },
  { icon: 'clock', t: 'Servicio 24 horas a nivel nacional' },
];
const vehiculos = [
  { t: 'Vehículos particulares', d: 'Tipo sedán' },
  { t: 'Vehículos de placa blanca', d: 'Transporte especial' },
  { t: 'Turbos', d: 'Transporte de carga' },
  { t: 'Minivan' },
  { t: 'Buses' },
];
---

<Base
  title="Transporte Premium | Línea+Vital"
  description="Luxury Auto Service: conductor elegido, expresos y viajes nacionales, recogida puerta a puerta y servicio 24 horas a nivel nacional."
  tema="transporte"
  msg={msg}
>
  <Hero
    title="Transporte"
    hl="premium"
    tag="Luxury Auto Service"
    tagIcon="car"
    sub="Servicio de transporte premium, 24 horas a nivel nacional."
    msg={msg}
  />

  <section class="sec">
    <div class="wrap">
      <div class="head">
        <h2 class="h2">El servicio</h2>
      </div>
      <div class="grid4">
        {servicios.map((s) => (
          <div class="card">
            <span class="ico"><Icon name={s.icon} size={22} /></span>
            <h3>{s.t}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec alt">
    <div class="wrap">
      <div class="head">
        <h2 class="h2">Vehículos disponibles</h2>
      </div>
      <div class="grid3">
        {vehiculos.map((v) => (
          <div class="tile"><Icon name={v.t === 'Buses' || v.t === 'Minivan' ? 'bus' : 'car'} size={22} /><span>{v.t}{v.d && <small class="tile-sub">{v.d}</small>}</span></div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="¿Necesitas transporte?" text="Cuéntanos el trayecto y el tipo de vehículo." msg={msg} />
</Base>
