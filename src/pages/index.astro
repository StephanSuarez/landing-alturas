---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Hero from '../components/Hero.astro';
import Catalog from '../components/Catalog.astro';
import CtaBand from '../components/CtaBand.astro';
import { categorias, conceptos, RED_NACIONAL } from '../data/site';

// Beneficios del brief.
const beneficios = [
  { icon: 'globe', t: 'Cobertura nacional', d: 'Acceso a servicios y aliados en diferentes ciudades de Colombia.' },
  { icon: 'shield', t: 'Respaldo profesional', d: 'Soluciones enfocadas en salud ocupacional, seguridad y bienestar.' },
  { icon: 'check', t: 'Prevención', d: 'Orientación para reducir riesgos legales y operativos.' },
  { icon: 'heart', t: 'Bienestar laboral', d: 'Servicios orientados al cuidado y calidad de vida de los colaboradores.' },
  { icon: 'trend', t: 'Productividad', d: 'Un enfoque integral para empresas y equipos de trabajo.' },
];
---

<Base
  title="Línea+Vital | Soluciones integrales para empresas y personas"
  description="Salud ocupacional, seguridad, bienestar y servicios especializados para empresas y personas con cobertura nacional."
>
  <Hero
    title="Soluciones integrales para"
    hl="empresas y personas"
    tag="Cobertura nacional"
    tagIcon="globe"
    sub="Salud ocupacional, seguridad, bienestar y servicios especializados con cobertura nacional."
    text="En Línea+Vital protegemos lo que realmente impulsa a las empresas: su gente. Somos especialistas en salud ocupacional, seguridad industrial y bienestar laboral, conectando salud, seguridad y bienestar con soluciones integrales para empresas y trabajadores."
    second={{ label: 'Conoce nuestros servicios', href: '#servicios' }}
  >
    <p class="ally"><Icon name="shield" size={18} /> Alianza estratégica con <b>Salud Total EPS</b></p>
    <div class="qcats" slot="aside">
      {categorias.map((c) => (
        <a class="qcat" href={`#${c.id}`}>
          <Icon name={c.icon} size={26} />
          <b>{c.titulo}</b>
          <span>{c.items.length} servicios</span>
        </a>
      ))}
    </div>
  </Hero>

  <section class="sec alt" id="servicios">
    <div class="wrap">
      <div class="head">
        <h2 class="h2">Todo lo que necesitas en un solo lugar</h2>
        <p class="sub">Nuestro portafolio integra diferentes soluciones para empresas, trabajadores y familias.</p>
      </div>
      <Catalog />
    </div>
  </section>

  <section class="sec">
    <div class="wrap two mid">
      <div>
        <span class="kicker">Propuesta de valor</span>
        <h2 class="h2">Un aliado estratégico para su empresa</h2>
        <p class="sub">Nos convertimos en un aliado estratégico de las empresas colombianas, conectando salud, seguridad y bienestar con soluciones integrales.</p>
        <p class="info"><Icon name="users" size={18} />{RED_NACIONAL}</p>
      </div>
      <div class="grid2">
        {conceptos.map((c) => <div class="tile"><Icon name={c.icon} size={22} />{c.t}</div>)}
      </div>
    </div>
  </section>

  <section class="sec alt">
    <div class="wrap">
      <div class="head">
        <h2 class="h2">Beneficios para su empresa</h2>
      </div>
      <div class="grid5">
        {beneficios.map((b) => (
          <div class="card">
            <span class="ico"><Icon name={b.icon} size={22} /></span>
            <h3>{b.t}</h3>
            <p>{b.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    title="¿Necesitas alguno de nuestros servicios?"
    text="Cuéntanos qué necesitas y te orientaremos sobre el proceso."
    contacto
  />
</Base>
