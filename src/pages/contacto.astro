---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import { wa, WHATSAPP_VISIBLE, redes } from '../data/site';
---

<Base title="Contacto | Línea Vital" description="Escríbenos por WhatsApp para cursos de alturas, exámenes médicos y seguridad social.">
  <section class="navy">
    <div class="wrap hero short">
      <div class="stack">
        <span class="tag">Contacto</span>
        <h1 class="h1 sm">Escríbenos por <span class="g">WhatsApp</span></h1>
        <p class="lead">Dinos qué necesitas y para cuántas personas. Te atiende Lorena Martínez.</p>
        <a class="cta" href={wa()} target="_blank" rel="noopener"><Icon name="wa" size={18} /> Hablar por WhatsApp <Icon name="arrow" size={16} /></a>
        <p class="hero-price">{WHATSAPP_VISIBLE}</p>
      </div>
      <ContactForm />
    </div>
  </section>

  <section class="sec">
    <div class="wrap pillars" style="margin-top: 0;">
      <div class="pillar">
        <h3>Redes</h3>
        <p>
          <a href={redes.instagram} target="_blank" rel="noopener">Instagram @lineavitalco</a><br />
          <a href={redes.tiktok} target="_blank" rel="noopener">TikTok @lineavitalco</a><br />
          {redes.facebook ? <a href={redes.facebook} target="_blank" rel="noopener">Facebook Linea Vital</a> : 'Facebook Linea Vital'}
        </p>
      </div>
      <div class="pillar">
        <h3>Horario</h3>
        <p>[Horario de atención por confirmar]</p>
      </div>
      <div class="pillar">
        <h3>Sede</h3>
        <p>[Dirección y ciudad por confirmar]<br />Cobertura nacional.</p>
      </div>
    </div>
  </section>
</Base>
