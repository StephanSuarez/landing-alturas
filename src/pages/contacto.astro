---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Hero from '../components/Hero.astro';
import ContactForm from '../components/ContactForm.astro';
import { telefonos, tel, CORREO, redes } from '../data/site';
---

<Base title="Contacto | Línea+Vital" description="Hablemos: teléfonos, WhatsApp y correo de Línea+Vital. Cobertura y servicio a nivel nacional.">
  <Hero
    title="Hablemos"
    tag="Contacto"
    tagIcon="phone"
    sub="Estamos listos para ayudarte"
    text="Tenemos cobertura y servicio a nivel nacional."
  >
    <ContactForm slot="aside" title="Envíanos tu solicitud" />
  </Hero>

  <section class="sec">
    <div class="wrap grid3">
      <div class="card">
        <span class="ico"><Icon name="phone" size={22} /></span>
        <h2 class="h3">Teléfonos</h2>
        <ul class="contact-list">
          {telefonos.map((t) => <li><a href={tel(t.numero)}>{t.numero}</a>{t.nota && <span>{t.nota}</span>}</li>)}
        </ul>
      </div>
      <div class="card">
        <span class="ico"><Icon name="mail" size={22} /></span>
        <h2 class="h3">Correo</h2>
        <ul class="contact-list"><li><a href={`mailto:${CORREO}`}>{CORREO}</a></li></ul>
      </div>
      <div class="card">
        <span class="ico"><Icon name="heart" size={22} /></span>
        <h2 class="h3">Redes</h2>
        <ul class="contact-list">
          <li><a href={redes.instagram} target="_blank" rel="noopener">Instagram @lineavitalco</a></li>
          <li><a href={redes.tiktok} target="_blank" rel="noopener">TikTok @lineavitalco</a></li>
          <li>{redes.facebook ? <a href={redes.facebook} target="_blank" rel="noopener">Facebook Linea Vital</a> : 'Facebook Linea Vital'}</li>
        </ul>
      </div>
    </div>
  </section>
</Base>
