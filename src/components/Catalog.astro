---
// Catálogo por categorías. En escritorio todo abierto; en celular, acordeones.
import Icon from './Icon.astro';
import { categorias, ruta } from '../data/site';
---

<div class="catalog">
  {categorias.map((c) => (
    <details class="cat" id={c.id} open data-cat>
      <summary>
        <span class="ci"><Icon name={c.icon} size={22} /></span>
        <h3>{c.titulo}</h3>
        <span class="count">{c.items.length}</span>
        <Icon name="chev" size={18} class="chev" />
      </summary>
      <ul>
        {c.items.map((it) => <li><a href={ruta(it.href)}>{it.nombre}<Icon name="arrow" size={14} /></a></li>)}
      </ul>
    </details>
  ))}
</div>

<script>
  // En celular queda abierta solo la primera categoría, o la que pida el enlace (#salud-ocupacional…).
  const mq = matchMedia('(max-width: 700px)');
  const cats = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-cat]'));
  const ajustar = () => {
    const pedida = cats.find((d) => '#' + d.id === location.hash);
    cats.forEach((d, i) => { d.open = !mq.matches || d === pedida || (!pedida && i === 0); });
  };
  ajustar();
  mq.addEventListener('change', ajustar);
  addEventListener('hashchange', ajustar);
</script>
