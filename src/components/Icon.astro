};

interface Props {
  name: keyof typeof paths;
  size?: number;
  class?: string;
}

const { name, size = 20, class: cls } = Astro.props;
---

<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name]}></svg>
