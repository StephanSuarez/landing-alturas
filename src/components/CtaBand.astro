---
// Cierre de cada página: una frase, un botón a WhatsApp y el formulario como alternativa.
import Icon from './Icon.astro';
import Asesor from './Asesor.astro';
import { ruta, telefonos, tel, CORREO } from '../data/site';

interface Props {
  title: string;
  text?: string;
  label?: string;
  msg?: string;
  contacto?: boolean; // muestra teléfonos y correo debajo
}

const { title, text, label, msg, contacto = false } = Astro.props;
---

<section class="sec">
  <div class="wrap">
    <div class="band">
      <div class="band-txt">
        <h2 class="h2">{title}</h2>
        {text && <p class="sub">{text}</p>}
      </div>
      <div class="actions">
        <Asesor msg={msg} label={label} />
        <a class="ghost" href={ruta('/contacto#formulario')}>Usar el formulario</a>
      </div>
      {contacto && (
        <ul class="band-contact">
          {telefonos.map((t) => <li><a href={tel(t.numero)}><Icon name="phone" size={16} /> {t.numero}</a>{t.nota && <span>{t.nota}</span>}</li>)}
          <li><a href={`mailto:${CORREO}`}><Icon name="mail" size={16} /> {CORREO}</a></li>
        </ul>
      )}
    </div>
  </div>
</section>
