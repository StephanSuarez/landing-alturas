---
// El formulario no va a un servidor: arma el mensaje y abre WhatsApp con el texto listo.
import Icon from './Icon.astro';
import { servicios } from '../data/site';

interface Props {
  servicio?: string;
  title?: string;
  text?: string;
}

const { servicio, title = 'Solicita información', text = 'Déjanos tus datos y cuéntanos qué necesitas.' } = Astro.props;
---

<form class="form" id="formulario" data-wa-form>
  <h2>{title}</h2>
  <p>{text}</p>
  <label class="fld">Nombre completo
    <input name="nombre" required autocomplete="name" placeholder="Ana Gómez" />
  </label>
  <div class="fr">
    <label class="fld">Teléfono
      <input name="telefono" type="tel" required autocomplete="tel" inputmode="tel" placeholder="300 123 4567" />
    </label>
    <label class="fld">Correo electrónico
      <input name="correo" type="email" autocomplete="email" placeholder="ana@empresa.com" />
    </label>
  </div>
  <label class="fld">Servicio de interés
    <select name="servicio">
      {servicios.map((s) => <option selected={s === servicio}>{s}</option>)}
    </select>
  </label>
  <label class="fld">Mensaje
    <textarea name="mensaje" rows="3" placeholder="Cuéntanos qué necesitas y para cuántas personas."></textarea>
  </label>
  <button class="cta block" type="submit">Enviar solicitud <Icon name="arrow" size={16} /></button>
  <p class="fnote"><Icon name="wa" size={14} /> Al enviar se abre WhatsApp con tu solicitud lista.</p>
</form>

<script>
  import { wa } from '../data/site';

  document.querySelectorAll<HTMLFormElement>('[data-wa-form]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const d = new FormData(form);
      const campo = (k: string) => String(d.get(k) ?? '').trim();
      const texto = [
        `Hola, soy ${campo('nombre')}.`,
        `Me interesa: ${campo('servicio')}.`,
        `Teléfono: ${campo('telefono')}.`,
        campo('correo') && `Correo: ${campo('correo')}.`,
        campo('mensaje'),
      ].filter(Boolean).join('\n');
      const url = wa(texto);
      const win = window.open(url, '_blank');
      if (win) win.opener = null;
      else location.href = url; // si el navegador bloquea la pestaña nueva
    });
  });
</script>
